# ---- بک‌اند مرکزی ----

# توکن API پنل Connectix شما (از https://seller.connectix.vip/profile/api-token)
CONNECTIX_API_TOKEN=paste-your-token-here
CONNECTIX_BASE_URL=https://seller-api.connectix.vip/externel/v1

# دیتابیس (SQLite پیش‌فرض؛ برای تولید واقعی می‌توانید به PostgreSQL تغییر دهید)
DATABASE_URL=sqlite:///./connectix_bot.db

# پنل مدیریت تحت وب
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
SESSION_SECRET_KEY=change-this-to-a-random-long-string

# آدرس عمومی بک‌اند (برای معرفی به کلاینت ربات‌های نمایندگان روی سرور شخصی‌شان)
PUBLIC_BACKEND_URL=https://your-domain-or-ip:8000

# پورتی که uvicorn روی آن اجرا می‌شود (باید با --port در systemd/دستور اجرا یکی باشد)
INTERNAL_PORT=8000

# ---- کلاینت ربات (bot_client) ----
# این مقادیر فقط وقتی لازم است که bot_client را جدا (مثلاً روی سرور یک نماینده) اجرا کنید
BOT_API_KEY=
BOT_TELEGRAM_TOKEN=
BACKEND_URL=http://127.0.0.1:8000

# ---- درگاه پرداخت (اختیاری، بعداً تکمیل کنید) ----
ZARINPAL_MERCHANT_ID=
CRYPTO_WALLET_ADDRESS=
